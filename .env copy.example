# ============================================================
# VARIABLES DE ENTORNO — dp-proj-00-02-admin
# ============================================================
# Copia este archivo a .env y rellena con los valores reales
# de Firebase Console > Configuración del proyecto > Tus apps
# ============================================================

VITE_ADMIN_FIREBASE_API_KEY=
VITE_ADMIN_FIREBASE_AUTH_DOMAIN=
VITE_ADMIN_FIREBASE_PROJECT_ID=
VITE_ADMIN_FIREBASE_APP_ID=

# ── Backend (Cloud Run) ──────────────────────────────────────
#
# DESARROLLO LOCAL (recomendado):
#   - Deja VITE_ADMIN_BACKEND_BASE_URL vacío o comentado
#   - Define VITE_ADMIN_BACKEND_PROXY_TARGET con la URL de Cloud Run
#   - Vite redirigirá /admin-backend/* al target (sin CORS)
#
# PRODUCCIÓN (build/hosting):
#   - Define VITE_ADMIN_BACKEND_BASE_URL con la URL absoluta de Cloud Run
#   - VITE_ADMIN_BACKEND_PROXY_TARGET se ignora en producción
#
# VITE_ADMIN_BACKEND_BASE_URL=https://<tu-servicio>.a.run.app
VITE_ADMIN_BACKEND_PROXY_TARGET=https://<tu-servicio>.a.run.app

# Opcional: usar emuladores locales durante desarrollo
# VITE_USE_FIREBASE_EMULATORS=true
